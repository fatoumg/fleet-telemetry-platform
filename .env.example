# Local infrastructure settings. Copy to `.env` only if you need to override something.
#
#   cp .env.example .env
#
# You usually do not need to. This project calls no external APIs, so there are no
# credentials to obtain -- every value below has a built-in default in
# src/fleet_telemetry/config.py that matches docker/docker-compose.yml. A fresh clone runs
# with no `.env` at all.
#
# Check what the loader resolved, and which values fell back to defaults:
#
#   python -m fleet_telemetry.config
#
# `.env` is git-ignored; this template is not. Never put a real secret here.


# ---------------------------------------------------------------------------
# OLTP database -- what the application writes to
# ---------------------------------------------------------------------------
# Deliberately separate from the warehouse: an application bug must not be able
# to corrupt analytics, and analytics must never query the operational database
# directly. Different name, user and port from the warehouse, so connecting to
# the wrong one fails loudly instead of quietly succeeding.
#
# Debezium reads this instance's write-ahead log, which requires
# wal_level=logical -- set in the compose file, not here.
OLTP_HOST=127.0.0.1
OLTP_PORT=55433
OLTP_DB=fleet
OLTP_USER=fleet
OLTP_PASSWORD=fleet


# ---------------------------------------------------------------------------
# Analytics warehouse -- Postgres + PostGIS + TimescaleDB
# ---------------------------------------------------------------------------
# Read by dbt/profiles.yml via env_var() and by the Python loader.
#
# Port 55432 is deliberate, not arbitrary: 5432 is held by a locally installed
# PostgreSQL, and on Windows a container can bind a port a host service already
# has -- both listen, clients silently reach the host server, and the symptom is
# an authentication failure that reads as a credentials bug. See the comment in
# docker/docker-compose.yml.
WAREHOUSE_HOST=127.0.0.1
WAREHOUSE_PORT=55432
WAREHOUSE_DB=telemetry
WAREHOUSE_USER=telemetry
WAREHOUSE_PASSWORD=telemetry


# ---------------------------------------------------------------------------
# Broker -- Redpanda locally, Kafka wire protocol
# ---------------------------------------------------------------------------
# Carries Debezium change events out of the OLTP database. Redpanda is a single
# container with no ZooKeeper or KRaft setup; because it speaks the Kafka
# protocol, swapping in real Kafka needs no application change.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# A static bearer token the simulator presents. This is not real security -- it
# exists so the simulator behaves like a client rather than writing to the
# database behind the application's back.
FLEET_API_TOKEN=local-dev-token

# Where the simulator looks for the application. The compose simulator overrides
# this to http://api:8000, because inside the compose network services address
# each other by service name and the host port mapping does not exist there.
FLEET_API_URL=http://127.0.0.1:8000

# Host port the api container publishes on.
API_PORT=8000

# Lets a client dictate server_ts. MUST stay false except when deliberately
# backfilling history -- server_ts is the only timestamp in the system no client
# can influence, which is the entire reason it can be trusted. A silent override
# would destroy that, and the rows would still look perfectly plausible.
FLEET_ALLOW_SERVER_TS_OVERRIDE=false


# ---------------------------------------------------------------------------
# Simulator -- the compose service that runs continuously
# ---------------------------------------------------------------------------
# At these defaults the simulator writes 2 rows/sec, ~173,000/day, roughly
# 43 MB/day with indexes -- small enough to leave running.
#
# The design's full fleet is 40 vehicles. That is four times the volume and more
# than a gigabyte a week, so it is deliberately opt-in rather than the default:
# set SIM_VEHICLES=40 when you want throughput to be the thing under test.
#
# Only the first N active vehicles by id report. The rest keep their existing
# rows and simply stop producing new ones -- which in the data is
# indistinguishable from a device that failed, so do not read a silent vehicle
# as a finding.
#
# Changing the interval makes new data incomparable with the phase 1 baseline,
# which was measured at 5s -- worth knowing before you attribute a difference to
# something else.
SIM_VEHICLES=10
SIM_INTERVAL=5

# Credentials for the three upstream sources. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is git-ignored; this template is not. Never put real values here.
# Check what the loader sees with:  python scripts/config.py


# ---------------------------------------------------------------------------
# OpenSky Network -- flight state vectors
# ---------------------------------------------------------------------------
# Register at https://opensky-network.org/ then create an API client under
# Account -> API Client. Basic auth was removed 2026-03-18; OAuth2
# client-credentials is the only supported scheme.
#
# Anonymous access still works without these (400 credits/day, no history).
# With them: 4,000 credits/day, 1 hour of state history at 5-second resolution.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# ACLED -- conflict events
# ---------------------------------------------------------------------------
# Register a myACLED account at https://acleddata.com/
#
# There is no API key any more. Auth is an OAuth password grant against
# https://acleddata.com/oauth/token using your account email and password
# (grant_type=password, client_id=acled, scope=authenticated). Tokens last
# 24 h; refresh tokens last 14 days.
#
# Note ACLED attaches licensing terms to data use -- read them before
# publishing anything derived from this.
ACLED_USERNAME=
ACLED_PASSWORD=


# ---------------------------------------------------------------------------
# Copernicus Climate Data Store -- ERA5 weather
# ---------------------------------------------------------------------------
# Register at https://cds.climate.copernicus.eu/, accept the ERA5 licence,
# then copy your token from https://cds.climate.copernicus.eu/how-to-api
#
# The catalogue is readable without credentials; only downloads need them.
# Needs: pip install cdsapi xarray netCDF4
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=


# ---------------------------------------------------------------------------
# Analytics warehouse (docker/docker-compose.yml)
# ---------------------------------------------------------------------------
# Defaults in the compose file match these, so a plain
# `docker compose -f docker/docker-compose.yml up -d` works with no .env at all.
# Read by dbt/profiles.yml via env_var() and by the Python loader.
WAREHOUSE_HOST=127.0.0.1
WAREHOUSE_PORT=55432
WAREHOUSE_DB=aviation
WAREHOUSE_USER=aviation
WAREHOUSE_PASSWORD=aviation
